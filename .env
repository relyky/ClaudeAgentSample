# Claude Agent Sample - 環境變數設定檔 (範本)
#
# 使用說明:
# 1. 複製此檔案為 .env.local
# 2. 在 .env.local 中填入實際的敏感資訊
# 3. .env.local 不會被提交到版本控制

# Anthropic API 金鑰
# 取得金鑰: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-api-key-here

# Claude 模型設定
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# 系統提示詞
CLAUDE_SYSTEM_PROMPT=你是一個樂於助人的助手。你會說中文，台灣口語為主。展示工作步驟。

# 對話設定
MAX_TURNS=

# MCP 伺服器設定 (選用)
# ENABLE_MCP_FETCH=true
