# Claude Agent Sample - 本地環境變數設定檔
#
# 此檔案用於存放本地開發環境的實際設定值
# ⚠️ 此檔案包含敏感資訊，已被 .gitignore 排除，不會提交到版本控制

# Anthropic API 金鑰 (必填)
ANTHROPIC_API_KEY=

# Claude 模型設定 (選用，預設使用 .env 中的值)
# CLAUDE_MODEL=claude-sonnet-4-5-20250929
# CLAUDE_MODEL=claude-3-5-haiku-20241022

# 對話設定 (選用)
# MAX_TURNS=

# 開發環境設定 (開發時可設為 true)
DEBUG=true
